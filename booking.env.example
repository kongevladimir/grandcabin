# Copy into the deployment environment, never into NEXT_PUBLIC_* variables.
# Run supabase/booking.sql in a private Supabase project first.
BOOKING_LOCAL_PREVIEW=false
BOOKING_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
BOOKING_SUPABASE_SERVICE_KEY=
BOOKING_SITE_URL=https://YOUR_CANONICAL_WEBSITE_DOMAIN
BOOKING_OWNER_EMAIL=
BOOKING_EMAIL_FROM=Grandcabin <booking@YOUR_VERIFIED_DOMAIN>
RESEND_API_KEY=
# Use independent randomly generated secrets, not the local preview values.
BOOKING_SESSION_SECRET=
BOOKING_OWNER_PASSWORD=
